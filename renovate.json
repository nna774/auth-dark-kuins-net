{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Tokyo",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 9am on monday"]
  },
  "packageRules": [
    {
      "description": "Rack 3 では Rack::Session::Cookie が rack-session に分かれ、Sinatra 4 も要る。nginx_omniauth_adapter が対応するまで 2.2 に留める",
      "matchPackageNames": ["rack"],
      "allowedVersions": "< 3"
    }
  ]
}
